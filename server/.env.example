# MariaDB / MySQL used by the importer and the API.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=realestate_insights

# API port (the Vite dev server proxies /api here).
PORT=8000

# Excel source for `npm run db:import`.
SOURCE_XLSX=../تجميع اراضي.xlsx

# Listen on this machine only (leave unset on a hosting panel such as Plesk).
HOST=127.0.0.1

# Documents (scans, contracts, field visits) indexed by `npm run docs:ingest`.
# Where the stored files live: keep it outside the web root.
DOCS_DIR=../storage/documents
# The documents are served only when the site has a password. Set both on the server:
#BASIC_AUTH_USER=
#BASIC_AUTH_PASSWORD=
# Local work only: serve the documents without a password.
DOCS_OPEN=1
